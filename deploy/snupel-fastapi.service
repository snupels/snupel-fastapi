[Unit]
Description=Snupel FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/snupel-fastapi
EnvironmentFile=/home/ubuntu/snupel-fastapi/.env
ExecStart=/home/ubuntu/snupel-fastapi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
