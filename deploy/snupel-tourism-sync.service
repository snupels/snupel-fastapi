[Unit]
Description=Sync Snupel tourism data
After=network-online.target mysql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/snupel-fastapi
EnvironmentFile=/home/ubuntu/snupel-fastapi/.env
ExecStart=/home/ubuntu/snupel-fastapi/.venv/bin/python -m app.jobs.sync_tourism
NoNewPrivileges=true
PrivateTmp=true
